# Environment variables hed-server reads. Copy to .env (gitignored) or set
# in the shell/container; every value here is a placeholder, not a default.

# Flask secret key for sessions and CSRF. Required in production.
SECRET_KEY=replace-with-a-random-value

# Dotted path of the config class to load (see config_template.py).
HEDTOOLS_CONFIG_CLASS=config.ProductionConfig

# Base directory for uploads and working files (defaults to the system temp dir).
HED_BASE_DIRECTORY=/path/to/working/dir

# URL prefix and static path when served behind a reverse proxy.
HED_URL_PREFIX=/hed
HED_STATIC_URL_PATH=/hed/hedweb/static

# Server URL the service tests target (run_service_tests.py sets it itself).
HED_SERVER_URL_KEY=http://127.0.0.1:5000
