# Build context for deploy/Dockerfile's multi-stage build. Docker reads
# .dockerignore from the root of the build context (this repo checkout), not
# from next to the Dockerfile, so this file lives here rather than in deploy/.
#
# .git is intentionally NOT excluded: deploy/Dockerfile's first build stage
# needs it so setuptools-scm can compute hedweb's real version and commit
# hash from git history. Only that first stage ever sees .git or anything
# else listed here - the final runtime image only copies out the wheel that
# stage produces.
#
# Everything below is local development cruft that would otherwise bloat the
# build context sent to the Docker daemon, especially when deploy.sh is run
# from inside an existing checkout (RUNNING_IN_REPO=true) that has a virtual
# environment, caches, and other generated files sitting in it.

.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ruff_cache/
.pytest_cache/
.status/
.vscode/
.idea/

# Auto-generated by setuptools-scm; regenerated fresh during the wheel build
hedweb/_version.py

# Docs build output
docs/_build/
docs_old/_build/

# Test / coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml

# Scratch files from previous script runs, if any are lying around
wheelhouse/
*.whl

# Local dev config (gitignored, may contain a real SECRET_KEY or other
# environment-specific values). The runtime stage always gets its config.py
# from deploy/base_config.py instead, but a local one sitting in the checkout
# would otherwise still be copied into the builder stage via `COPY . .`.
config.py

# Legacy GitHub token file. No longer used (hedtools resolves schema versions
# from the CDN manifest, no token needed), but keep it out of the build context
# so a stray copy left in an old checkout can never be baked into an image layer
# via the builder stage's `COPY . .`.
deploy/.github_token